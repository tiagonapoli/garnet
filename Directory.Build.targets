<Project>
  <PropertyGroup>
    <EnableGarnetAsserts>true</EnableGarnetAsserts>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableGarnetAsserts)' == 'true'">
    <DefineConstants>$(DefineConstants);GARNET_ASSERT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Garnet.Diagnostics" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Garnet.Diagnostics'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)libs/diagnostics/Garnet.Diagnostics.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Store-Buffer litmus harness for LightEpoch, plus a console driver for it.

       This is a tool, not a test assembly. It lives here because the harness is only
       meaningful next to the epoch tests, but it is a separate project for two reasons:
       the NUnit host cannot pin threads to specific logical processors the way this
       harness needs, and a plain executable can be shipped in a container and pointed
       at real hardware (see Dockerfile). Garnet.LightEpoch.test references it so the
       NUnit tests and the CLI drive exactly the same code. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Garnet.LightEpoch.litmus</AssemblyName>
    <RootNamespace>Tsavorite.epoch.litmus</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../../../../../../Garnet.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;1591;IDE0130;IDE0065;IDE0007;IDE0048</NoWarn>

    <!-- The harness measures memory ordering, so the runtime must not reshape the run.
         Tiered compilation would leave the hot loop in tier-0 code for the first part of
         a short run, and a background/concurrent GC introduces pauses that swamp the
         microsecond race window this is trying to sample. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Garnet.LightEpoch.test" Key="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\epoch\Garnet.LightEpoch.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;CS0169;CS0649</NoWarn>
    <Optimize>true</Optimize>
    <Configuration>Release</Configuration>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!--
    Set CaptureDisasm=true to have the NativeAOT compiler dump RyuJIT assembly for
    the methods named in JitDisasmMethods. ILC hosts the same RyuJIT the runtime
    uses and cross-targets, which is what lets one x64 host produce both the
    x86-64 and the AArch64 listings. See capture.sh.

    Without this property the project still builds and runs as an ordinary JIT
    console app, which is the flow the runtime-JIT capture in README.md uses.
  -->
  <ItemGroup Condition="'$(CaptureDisasm)' == 'true'">
    <IlcArg Include="--codegenopt:JitDisasm=$(JitDisasmMethods)" />
    <IlcArg Include="--codegenopt:JitDisasmDiffable=1" />
    <!-- ILC compiles methods in parallel and every thread writes to the same
         stdout, which interleaves lines from different listings. Serialising
         codegen is what makes the captured assembly trustworthy. -->
    <IlcArg Include="--parallelism" />
    <IlcArg Include="1" />
  </ItemGroup>
</Project>
